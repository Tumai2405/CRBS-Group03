digraph G {rankdir=LR; graph [label="M-07 Resource State Machine (separate from Booking State)",labelloc=t,fontsize=18,fontname="Arial"]; node [shape=box,style="rounded,filled",fontname="Arial",fontsize=10,color="#53769c"]; edge [fontname="Arial",fontsize=9]; A [label="Available",fillcolor="#d9ead3"]; R [label="Reserved",fillcolor="#d9eaf7"]; U [label="In Use",fillcolor="#fff2cc"]; M [label="Under Maintenance",fillcolor="#f4cccc"]; I [label="Inactive",fillcolor="#d9d9d9"]; A->R[label="Booking slot reserved"]; R->A[label="Cancelled/Rejected or slot ends"]; R->U[label="Checkout/room use begins"]; U->A[label="Return Good + no incident / use ends"]; U->M[label="Damaged/Missing or incident opened"]; A->M[label="Incident opened"]; R->M[label="Incident opened; pending approval blocked"]; M->A[label="Resolved; all incidents closed; active"]; A->I[label="Deactivated"]; I->A[label="Reactivated and no open incident"]; }