digraph G {rankdir=TB; graph [label="M-06 Equipment Checkout / Check-in / Maintenance",labelloc=t,fontsize=18,fontname="Arial"]; node [shape=box,style="rounded,filled",fillcolor="#eef4fb",color="#53769c",fontname="Arial",fontsize=10]; edge [fontname="Arial",fontsize=9]; s [shape=oval,label="Approved booking + eligible equipment",fillcolor="#d9ead3"]; a [shape=diamond,label="Active and no open maintenance incident?"]; b [label="Block checkout; notify Staff",fillcolor="#fce4d6"]; c [label="Record checkout staff + timestamp; state In Use"]; d [label="On return, inspect and require condition"]; e [shape=diamond,label="Condition?"]; f [label="Good: record check-in; Available only if no incident",fillcolor="#d9ead3"]; g [label="Damaged/Missing: record condition + open/link incident; Under Maintenance",fillcolor="#fce4d6"]; h [label="Repair; record resolution; close incident",fillcolor="#fff2cc"]; i [shape=diamond,label="Any open incident remains?"]; j [label="Keep unavailable",fillcolor="#fce4d6"]; k [label="Restore Available",fillcolor="#d9ead3"]; end [shape=oval,label="Lifecycle recorded in audit",fillcolor="#d9ead3"]; s->a; a->b[label="No"]; b->end; a->c[label="Yes"]; c->d->e; e->f[label="Good"]; e->g[label="Damaged/Missing"]; f->end; g->h->i; i->j[label="Yes"]; i->k[label="No"]; j->end; k->end;}