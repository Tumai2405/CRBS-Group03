digraph G {rankdir=TB; graph [label="M-08 HZ-02 Hazard Cause Tree: Check-in Condition Failure",labelloc=t,fontsize=18,fontname="Arial",nodesep=.35,ranksep=.5]; node [shape=box,style="rounded,filled",fontname="Arial",fontsize=10]; edge [fontname="Arial",fontsize=9]; c [label="Cause: condition check skipped / incorrect entry",fillcolor="#fff2cc",color="#b38f00"]; f [label="Intermediate failure: damaged item recorded as Good / Available; no open incident",fillcolor="#fce4d6",color="#c0504d"]; h [label="Hazard: next group books or receives damaged equipment",fillcolor="#f4cccc",color="#c0504d"]; e [label="Effect: class disruption, equipment damage, possible safety issue",fillcolor="#f4cccc",color="#c0504d"]; b1 [label="Preventive barrier: mandatory condition + valid values",fillcolor="#d9ead3",color="#548235"]; b2 [label="State barrier: Damaged/Missing → open incident + Under Maintenance",fillcolor="#d9ead3",color="#548235"]; b3 [label="Enforcement: search/booking/checkout block open incident",fillcolor="#d9ead3",color="#548235"]; b4 [label="Recovery: repair resolution + explicit incident closure",fillcolor="#d9ead3",color="#548235"]; c->f->h->e; b1->f[style=dashed,label="blocks cause" ]; b2->f[style=dashed,label="blocks false state"]; b3->h[style=dashed,label="blocks reuse"]; b4->b2[style=dashed,label="restores only after repair"]; }