digraph G {rankdir=TB; graph [label="M-04 Facility Staff Decision",labelloc=t,fontsize=18,fontname="Arial"]; node [shape=box,style="rounded,filled",fillcolor="#eef4fb",color="#53769c",fontname="Arial",fontsize=10]; edge [fontname="Arial",fontsize=9]; s [shape=oval,label="Open Pending Staff Approval queue",fillcolor="#d9ead3"]; a [label="Review purpose, requester, supervisor endorsement, room + items"]; b [shape=diamond,label="Student practice? "]; c [shape=diamond,label="Lecturer endorsed? "]; d [label="Do not approve; return to pending lecturer confirmation",fillcolor="#fce4d6"]; e [label="Re-check every resource atomically"]; f [shape=diamond,label="All active, permitted, no maintenance/conflict? "]; g [label="Approve; record actor/time; audit + notify",fillcolor="#d9ead3"]; h [label="Reject with reason; audit + notify",fillcolor="#fce4d6"]; end [shape=oval,label="Decision complete",fillcolor="#d9ead3"]; s->a->b; b->c[label="Yes"]; b->e[label="No"]; c->d[label="No"]; d->end; c->e[label="Yes"]; e->f; f->g[label="Yes"]; f->h[label="No"]; g->end; h->end;}